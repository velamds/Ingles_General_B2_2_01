nt": " What would she do?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the text and select all the hypothetical sentences.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "type": "SLS", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "correct": 0, "_data": [{"content": "", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn10le01ob10re2img01.jpg"}, {"text": "<span class=\"strong\">John</span>: That was some movie eh, Peter? I still haven't gotten it out of my mind.\n<br><span class=\"strong\">Peter</span>: I told you sci-fi movies are awesome! There are so many great ones out there as well. If you give sci-fi a chance now, you won't regret it. You may even discover a whole new passion!\n<br><span class=\"strong\">John</span>: I know. I'm planning on watching <span class=\"italic\">Star Wars</span> later on tonight. I heard it's one of the best movies of all time. It must be good!", "id": 1, "time": "100", "image": "engenn10le01ob10re2img01.jpg"}, {"text": "<span class=\"strong\">Peter</span>: <span class=\"italic\">Star Wars</span> is amazing! Man, if I didn't have plans, I would come over and watch it.\n<br><span class=\"strong\">John</span>:  Really? Well cancel them. I am sure you could reschedule.\n<br><span class=\"strong\">Peter</span>: Well, that might be a problem. I'm meeting a girl, Amanda, tonight. If I don't show up, she will never talk to me again.\n<br><span class=\"strong\">John</span>: Wow. You must cancel on her a lot. Ah well, come on! Just give her a better excuse. If I were in your shoes, I would cancel in a heartbeat. Come on! It's <span class=\"italic\">Star Wars</span>! It might be one of the best movies you ever see in your life!", "id": 2, "time": "25500", "image": "engenn10le01ob10re2img02.jpg"}, {"text": "<span class=\"strong\">Peter</span>: You do realize how hard you are making it for me right now. Ah fine! Only because I can't resist the temptation of <span class=\"italic\">Star Wars</span>. What should I tell her?\n<br><span class=\"strong\">John</span>: Tell her that you feel sick and if you felt better, you wouldn't cancel your plans with her.\n<br><span class=\"strong\">Peter</span>: Okay, I like that. You're my alibi if I ever need one.\n<br><span class=\"strong\">John</span>: If she calls you, don't pick up and tell her later you fell asleep. She can't get angry at you for that.\n<br><span class=\"strong\">Peter</span>: She will definitely believe that. Thanks John.", "id": 3, "time": "60000", "image": "engenn10le01ob10re2img05.jpg"}], "audiosrc": "engenn10le01ob10re2aud01", "coverimg": "engenn10le01ob10re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}